PROFILE_NAME=linux-amd64-native-release-nts
PROFILE_BUILD_TYPE=release
PROFILE_THREAD_SAFETY=nts
PROFILE_SANITIZER=none
PROFILE_TARGET_ID=linux-amd64-prod
PROFILE_TARGET_TRIPLE=x86_64-unknown-linux-gnu
PROFILE_HOST_SYSTEM=Linux
PROFILE_HOST_ARCH=x86_64
PROFILE_CC=clang
PROFILE_CXX=clang++
PROFILE_CONFIGURE_FLAGS=(--disable-debug --disable-zts --enable-native-engine --enable-native-mir-test --enable-zend-test)
PROFILE_FUNCTION_ORDER=scripts/native/layout/linux-amd64-wordpress.order
# The C runtime keeps RBP as a register, as a distribution build does: the
# nix clang wrapper enables frame pointers by default.
PROFILE_EXTRA_CFLAGS=-fomit-frame-pointer
