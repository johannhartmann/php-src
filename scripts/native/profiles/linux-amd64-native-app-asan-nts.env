PROFILE_NAME=linux-amd64-native-app-asan-nts
PROFILE_BUILD_TYPE=debug
PROFILE_THREAD_SAFETY=nts
PROFILE_SANITIZER=address
PROFILE_TARGET_ID=linux-amd64-prod
PROFILE_TARGET_TRIPLE=x86_64-unknown-linux-gnu
PROFILE_HOST_SYSTEM=Linux
PROFILE_HOST_ARCH=x86_64
PROFILE_CC=clang
PROFILE_CXX=clang++
# Sanitizer builds run at -O1, as the sanitizer runtimes recommend.
PROFILE_EXTRA_CFLAGS=-O1
PROFILE_CONFIGURE_FLAGS=(--enable-debug --disable-zts --enable-native-engine --enable-address-sanitizer --enable-ctype --enable-filter --enable-tokenizer --enable-mbstring --enable-session --with-iconv --enable-pdo --with-pdo-sqlite --with-sqlite3 --with-libxml --enable-xml --enable-dom --enable-simplexml --enable-xmlreader --enable-xmlwriter --with-zlib --with-mysqli --enable-mysqlnd)
