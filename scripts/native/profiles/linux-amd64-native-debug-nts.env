PROFILE_NAME=linux-amd64-native-debug-nts
PROFILE_BUILD_TYPE=debug
PROFILE_THREAD_SAFETY=nts
PROFILE_SANITIZER=none
PROFILE_TARGET_ID=linux-amd64-prod
PROFILE_TARGET_TRIPLE=x86_64-unknown-linux-gnu
PROFILE_HOST_SYSTEM=Linux
PROFILE_HOST_ARCH=x86_64
PROFILE_CC=clang
PROFILE_CXX=clang++
PROFILE_CONFIGURE_FLAGS=(--enable-debug --disable-zts --enable-fpm --enable-native-engine --enable-native-mir-test --enable-zend-test)
# Debug keeps assertions and MIR verification; -Og (after configure's -O0)
# roughly halves the per-test native compile cost.
PROFILE_EXTRA_CFLAGS=-Og
