PROFILE_NAME=darwin-arm64-native-product-release-nts
PROFILE_BUILD_TYPE=release
PROFILE_THREAD_SAFETY=nts
PROFILE_SANITIZER=none
PROFILE_TARGET_ID=darwin-arm64-dev
PROFILE_TARGET_TRIPLE=arm64-apple-darwin
PROFILE_HOST_SYSTEM=Darwin
PROFILE_HOST_ARCH=arm64
PROFILE_CONFIGURE_FLAGS=(--disable-debug --disable-zts --enable-native-engine --enable-fpm --enable-cgi --enable-phpdbg --enable-embed=static)
