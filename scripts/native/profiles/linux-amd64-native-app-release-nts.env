PROFILE_NAME=linux-amd64-native-app-release-nts
PROFILE_BUILD_TYPE=release
PROFILE_THREAD_SAFETY=nts
PROFILE_SANITIZER=none
PROFILE_TARGET_ID=linux-amd64-prod
PROFILE_TARGET_TRIPLE=x86_64-unknown-linux-gnu
PROFILE_HOST_SYSTEM=Linux
PROFILE_HOST_ARCH=x86_64
PROFILE_CC=clang
PROFILE_CXX=clang++
PROFILE_CONFIGURE_FLAGS=(--disable-debug --disable-zts --enable-native-engine --enable-fpm --enable-cgi --enable-ctype --enable-filter --enable-tokenizer --enable-mbstring --enable-session --with-iconv --enable-pdo --with-pdo-sqlite --with-sqlite3 --with-libxml --enable-xml --enable-dom --enable-simplexml --enable-xmlreader --enable-xmlwriter --with-zlib --with-mysqli --enable-mysqlnd)
