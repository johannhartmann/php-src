+/// Blocks reached with a probability below 1/100, from the branch
+/// probabilities and ignoring back edges: written to the cold area.
+static llvm::DenseMap<const llvm::MachineBasicBlock *, bool>
+    cold_block_set(llvm::MachineFunction *func) {
+  llvm::DenseMap<const llvm::MachineBasicBlock *, bool> cold;
+  llvm::ReversePostOrderTraversal<llvm::MachineFunction *> rpo(func);
+  llvm::DenseMap<const llvm::MachineBasicBlock *, unsigned> order;
+  for (const llvm::MachineBasicBlock *block : rpo) {
+    order[block] = order.size();
+  }
+  llvm::DenseMap<const llvm::MachineBasicBlock *, double> freq;
+  for (const llvm::MachineBasicBlock *block : rpo) {
+    double f = block == &func->front() ? 1.0 : 0.0;
+    for (const llvm::MachineBasicBlock *pred : block->predecessors()) {
+      if (!order.contains(pred) || order[pred] >= order[block]) {
+        continue;
+      }
+      for (auto it = pred->succ_begin(); it != pred->succ_end(); ++it) {
+        if (*it == block) {
+          const llvm::BranchProbability prob = pred->getSuccProbability(it);
+          f += freq[pred] * double(prob.getNumerator()) /
+               double(prob.getDenominator());
+        }
+      }
+    }
+    freq[block] = f;
+    cold[block] = block != &func->front() && f < 0.01;
+  }
+  return cold;
+}
