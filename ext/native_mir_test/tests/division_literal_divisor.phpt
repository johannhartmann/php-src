--TEST--
Native division and remainder by an integer literal
--DESCRIPTION--
A long literal divisor other than 0 and -1 is an immediate: a power of two
divides by shifts with the dividend's sign, other divisors by their magic
number, and an inexact quotient still divides in double precision. Zero,
-1, doubles, strings, booleans, null and references keep their semantics.
--INI--
opcache.enable=1
opcache.enable_cli=1
opcache.file_update_protection=0
--FILE--
<?php
function f($x) { $r = [];
  $r[] = $x / 1; $r[] = $x % 1;
  $r[] = $x / 2; $r[] = $x % 2;
  $r[] = $x / 4; $r[] = $x % 4;
  $r[] = $x / 8; $r[] = $x % 8;
  $r[] = $x / 1024; $r[] = $x % 1024;
  $r[] = $x / 2147483648; $r[] = $x % 2147483648;
  $r[] = $x / 4294967296; $r[] = $x % 4294967296;
  $r[] = $x / 3; $r[] = $x % 3;
  $r[] = $x / 1000; $r[] = $x % 1000;
  $r[] = $x / -2; $r[] = $x % -2;
  $r[] = $x / -4; $r[] = $x % -4;
  $r[] = $x / 7; $r[] = $x % 7;
  return $r; }
function g(int $x) { return [$x / 2, $x % 2, $x / 4, $x % 4, $x / 1000, $x % 1000, $x / 2147483648, $x % 2147483648, $x / 1, $x % 1]; }
$vals = [0, 1, -1, 2, -2, 3, -3, 7, -7, 8, -8, 1023, -1025, PHP_INT_MAX, PHP_INT_MIN, PHP_INT_MAX - 1, PHP_INT_MIN + 1, 4294967296, -4294967296, 2.5, -3.0, "6", true, null];
foreach ($vals as $v) { try { echo json_encode(f($v)), "\n"; } catch (Throwable $e) { echo get_class($e), ": ", $e->getMessage(), "\n"; } }
foreach ([0, 1, -1, 5, -5, 6, -6, PHP_INT_MAX, PHP_INT_MIN] as $v) { echo json_encode(g($v)), "\n"; }
$a = 10; $ref = &$a; var_dump($a / 4, $a % 4);
function z($x) { try { return $x / 0; } catch (DivisionByZeroError $e) { return $e->getMessage(); } }
function m1($x) { try { return $x % 0; } catch (DivisionByZeroError $e) { return $e->getMessage(); } }
var_dump(z(5), m1(5), PHP_INT_MIN / -1, PHP_INT_MIN % -1);
function loop($n) { $s = 0; for ($i = -$n; $i < $n; $i++) { $s += ($i % 8) + intdiv($i, 3) + ($i / 2 == (int)($i / 2) ? 1 : 0); } return $s; }
var_dump(loop(1000));
?>
