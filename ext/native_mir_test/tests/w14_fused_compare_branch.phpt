--TEST--
Native comparisons fused into their conditional branch
--DESCRIPTION--
A <, <=, == or != comparison whose only consumer is the JMPZ/JMPNZ after it
compares two numbers (through a reference) and jumps to the branch target
directly; other operands take the comparison helper and the branch tests its
result. Guarded operations without edge moves leave through plain jumps.
--INI--
opcache.enable=1
opcache.enable_cli=1
opcache.file_update_protection=0
--FILE--
<?php
class S { function __toString(): string { return "5"; } }
function cmpall($a, $b) {
    $r = "";
    if ($a < $b) { $r .= "<"; } else { $r .= "!<"; }
    if ($a <= $b) { $r .= "<="; } else { $r .= "!<="; }
    if ($a == $b) { $r .= "=="; } else { $r .= "!=="; }
    if ($a != $b) { $r .= "!="; } else { $r .= "!!="; }
    if (!($a < $b)) { $r .= "n<"; }
    return $r;
}
$vals = [0, 1, -1, 5, 2.5, -0.0, 0.0, NAN, INF, -INF, PHP_INT_MAX, PHP_INT_MIN, "5", "5.0", "abc", "", null, true, false, [1], [], new S, 9007199254740993];
foreach ($vals as $a) { foreach ($vals as $b) {
    try { echo @cmpall($a, $b), "|"; } catch (Throwable $e) { echo get_class($e), "|"; }
} echo "\n"; }
function loops($n) {
    $c = 0; $j = 1;
    while ($j <= $n) { $j += $j; $c++; }
    for ($i = 0.5; $i < $n; $i = $i * 3) { $c++; }
    $k = $n; while ($k != 0) { $k = intdiv($k, 2); $c++; }
    return $c;
}
var_dump(loops(1000), loops(0), loops("100"), loops(7.5));
function refcmp() { global $G; $x = 3; $r = &$x; $c = 0; while ($r < $G) { $r++; $c++; } return [$c, $x]; }
$G = 10; var_dump(refcmp());
function thrower($a) { try { if ($a < new ArrayObject([])) { return "lt"; } return "ge"; } catch (Throwable $e) { return get_class($e); } }
var_dump(thrower(1), thrower([1]));

?>

