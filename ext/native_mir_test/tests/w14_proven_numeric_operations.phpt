--TEST--
Native x64 numeric operations on proven numbers overflow into doubles inline
--DESCRIPTION--
Arithmetic and comparisons whose operands inference proves to be longs or
doubles compute integer overflow in double precision and test no other type.
--INI--
opcache.enable=1
opcache.enable_cli=1
opcache.file_update_protection=0
--FILE--
<?php
function f($a, $b) { $x = $a + $b; $y = $a - $b; $z = $a * $b; return [$x, $y, $z, $a < $b, $a <= $b, $a == $b, $a != $b]; }
function g($n) { $s = 0; for ($i = 0; $i < $n; $i++) { $s = $s + $i * 1.5; } return $s; }
function h(int $n) { $x = $n * 2 + 1; $y = $x * $x; return $y - $n; }
$vals = [0, 1, -1, PHP_INT_MAX, PHP_INT_MIN, 0.5, -2.5, NAN, INF, 3.0, 1e308];
foreach ($vals as $a) foreach ($vals as $b) { echo json_encode(f($a, $b), JSON_PARTIAL_OUTPUT_ON_ERROR), "\n"; }
var_dump(g(10), h(3), h(PHP_INT_MAX), h(PHP_INT_MIN), h(3037000499), h(-3037000500));
?>
