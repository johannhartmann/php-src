--TEST--
Native x64 inline arithmetic and comparison on frame operands
--DESCRIPTION--
Arithmetic and comparisons whose operands live in CV or temporary slots or
literals run inline for integers and floats, with the VM's overflow,
long/double promotion, NaN and division by zero semantics; other types use
the helper.
--EXTENSIONS--
opcache
--INI--
opcache.enable=1
opcache.enable_cli=1
opcache.file_update_protection=0
--SKIPIF--
<?php
if (!function_exists('native_mir_test_compile_execute')) {
    die('skip native_mir_test is not available');
}
?>
--FILE--
<?php
function ops($a, $b) {
    $r = [];
    $r[] = $a + $b; $r[] = $a - $b; $r[] = $a * $b;
    try { $r[] = $a / $b; } catch (DivisionByZeroError $e) { $r[] = 'div0'; }
    $r[] = $a < $b; $r[] = $a <= $b; $r[] = $a == $b; $r[] = $a != $b;
    $r[] = $a > $b; $r[] = $a >= $b;
    $r[] = $a + 1.5; $r[] = 2 * $a; $r[] = $a - 0.25; $r[] = $a < 3; $r[] = 1.0 == $a;
    return $r;
}
function loop() {
    $x = 0; $y = 0.5; $acc = 0;
    for ($i = 0; $i < 50; $i = $i + 1) {
        $x = $x + $i; $y = $y * 1.1; $acc = $acc + $x * $y - $i / 3;
        if ($y > 10.0) { $y = $y - 9.5; }
    }
    return [$x, $y, $acc];
}
$vals = [0, 1, -1, 7, PHP_INT_MAX, PHP_INT_MIN, 0.0, -0.0, 1.5, -2.25, NAN, INF, -INF, 1e308, "3", "2.5", "abc", null, true, false];
foreach ($vals as $a) {
    foreach ($vals as $b) {
        try {
            $res = @ops($a, $b);
        } catch (Throwable $e) {
            $res = get_class($e);
        }
        echo json_encode([$a, $b]) === false ? 'x' : '', var_export($res, true), "\n";
    }
}
var_dump(loop());
?>
